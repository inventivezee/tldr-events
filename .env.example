# TLDR Events — copy to .env.local and fill in. See README for how to obtain each.
# Do NOT commit real values.

# Database (Neon or Supabase Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# LLM (scorer + speaker-research synthesis)
LLM_PROVIDER=anthropic
LLM_API_KEY=
SCORING_MODEL=claude-opus-4-8
RESEARCH_MODEL=claude-sonnet-5

# Browserbase (browser scrapes + Google speaker research)
# Residential proxies are always used. Advanced stealth (Enterprise plan only)
# is opt-in — leave blank/false unless you're on Enterprise.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_ADVANCED_STEALTH=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# Cron endpoint protection
CRON_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_URL=

# Optional / future
MEETUP_API_TOKEN=

# Phase 2 (email) — deferred
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# SENDING_DOMAIN=
# PHYSICAL_ADDRESS=
